# Copy this file to .env and replace every placeholder before starting the stack.
# Keep .env on the server only. It is ignored by Git and Docker.
IMAGE_TAG=v1.0.0-rc.47
POSTGRES_PASSWORD=replace_with_a_long_random_password
REDIS_PASSWORD=replace_with_another_long_random_password
SESSION_SECRET=replace_with_a_long_random_session_secret
TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token
PUBLIC_DOMAIN=api.example.com
